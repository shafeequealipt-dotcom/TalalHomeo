---
// Resolves a doctor's `photo` key from clinic.json (e.g. "talal") to the file
// src/assets/doctors/talal.jpeg, and serves it through Astro's image pipeline
// (resized + WebP). To add a doctor: drop <key>.jpeg in that folder and set
// "photo": "<key>" on their entry in clinic.json.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo: string;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { photo, alt, widths, sizes, class: className, loading = 'lazy' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/doctors/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

const match = Object.entries(files).find(
  ([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === photo
);

if (!match) {
  throw new Error(`Doctor photo "${photo}" not found in src/assets/doctors/`);
}
---

<Image
  src={match[1].default}
  alt={alt}
  widths={widths}
  sizes={sizes}
  class={className}
  loading={loading}
  format="webp"
/>
