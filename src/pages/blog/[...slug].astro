---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import clinic from '../../data/clinic.json';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'MedicalClinic', name: clinic.name },
  mainEntityOfPage: new URL(`/blog/${post.id}`, Astro.site).href,
  keywords: post.data.tags.join(', '),
};
---

<Base
  title={`${post.data.title} | ${clinic.shortName}`}
  description={post.data.description}
  schema={postSchema}
  ogType="article"
>
  <article class="article">
    <div class="wrap">
      <div class="breadcrumb">
        <a href="/">Home</a> <span>/</span> <a href="/blog">Health notes</a>
      </div>

      <header class="article-head">
        <div class="article-meta">
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          {post.data.updatedDate && <span>Updated {fmt(post.data.updatedDate)}</span>}
          <span>{post.data.author}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <div class="tags" style="margin-top: var(--s4);">
          {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      </header>

      <div class="article-body">
        <Content />
      </div>

      <aside class="medical-note">
        <strong>A note on medical advice.</strong> This article is general information, not a
        prescription. Homoeopathic treatment is individualised — what suits one patient may not
        suit another. Do not stop or change any prescribed medication on your own. If a symptom
        is severe, sudden or worsening, seek medical attention rather than waiting.
      </aside>

      <div class="hero-cta" style="margin-top: var(--s6);">
        <a class="btn btn-wa" href={clinic.links.whatsapp} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> Ask about this on WhatsApp
        </a>
        <a class="btn btn-ghost" href="/blog">All health notes</a>
      </div>
    </div>
  </article>
</Base>
