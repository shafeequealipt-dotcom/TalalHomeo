---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import clinic from '../data/clinic.json';
---

<Base
  title="Page not found | Dr. Talal's Alsharaf Homoeo Medical Centre"
  description="That page doesn't exist. Find our treatments, health notes, consulting hours and directions instead."
>
  <section>
    <div class="wrap prose">
      <p class="kicker">404</p>
      <h1>That page isn't here.</h1>
      <p class="lede">
        The link may be old or mistyped. Here's where most people are heading:
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-ghost" href="/services">Treatments</a>
        <a class="btn btn-ghost" href="/contact">Hours &amp; directions</a>
      </div>
      <p style="margin-top: var(--s6);">
        Or reach the clinic directly on
        <a href={clinic.links.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a> or
        <a href={`tel:${clinic.phone.tel}`}>{clinic.phone.display}</a>.
      </p>
    </div>
  </section>
</Base>
